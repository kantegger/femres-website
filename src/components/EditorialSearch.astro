---
import { getLocalizedPath, type Locale } from "../i18n";
import { getTopicTranslation } from "../i18n/topicsUtils";
import { buildSearchPageData } from "../lib/searchPage";
import type { ContentType } from "../lib/content";
import CoverImage from "./editorial/CoverImage.astro";

interface Props {
  locale: Locale;
  pathMode: "root" | "locale";
}

const { locale, pathMode } = Astro.props;
const {
  t,
  searchPath,
  allContent,
  contentTypes,
  allTopics,
  currentQuery,
  currentType,
  currentTopic,
  currentSort,
  totalResults,
  totalPages,
  validPage,
  currentItems,
  getSearchUrl,
} = await buildSearchPageData({ locale, url: Astro.url, pathMode });

const copy: Record<Locale, {
  eyebrow: string;
  title: string;
  deck: string;
  search: string;
  all: string;
  browse: string;
  refine: string;
  topic: string;
  sort: string;
  clear: string;
  results: string;
  resultUnit: string;
  previous: string;
  next: string;
  noImage: string;
  by: string;
  empty: string;
  emptyHint: string;
}> = {
  "zh-CN": { eyebrow: "FemRes · 研究索引", title: "搜索", deck: "在书籍、影像、文章、声音与研究之间，寻找一个概念的来路、回声与连接。", search: "检索全部内容", all: "全部", browse: "按媒介浏览", refine: "缩小范围", topic: "全部议题", sort: "排序方式", clear: "清除条件", results: "检索结果", resultUnit: "项", previous: "上一页", next: "下一页", noImage: "无图像", by: "作者 / 创作者", empty: "没有找到相符内容", emptyHint: "试试更短的关键词，或清除媒介与议题筛选。" },
  "zh-TW": { eyebrow: "FemRes · 研究索引", title: "搜尋", deck: "在書籍、影像、文章、聲音與研究之間，尋找一個概念的來路、回聲與連結。", search: "檢索全部內容", all: "全部", browse: "按媒介瀏覽", refine: "縮小範圍", topic: "全部議題", sort: "排序方式", clear: "清除條件", results: "檢索結果", resultUnit: "項", previous: "上一頁", next: "下一頁", noImage: "無圖像", by: "作者 / 創作者", empty: "沒有找到相符內容", emptyHint: "試試更短的關鍵詞，或清除媒介與議題篩選。" },
  en: { eyebrow: "FemRes · Research index", title: "Search", deck: "Trace a concept across books, moving images, essays, voices, and feminist research.", search: "Search the entire collection", all: "All media", browse: "Browse by medium", refine: "Refine", topic: "All topics", sort: "Sort by", clear: "Clear filters", results: "Search results", resultUnit: "items", previous: "Previous", next: "Next", noImage: "No image", by: "By", empty: "No matching material", emptyHint: "Try a shorter keyword or remove the medium and topic filters." },
  ja: { eyebrow: "FemRes · 研究索引", title: "検索", deck: "書籍、映像、記事、声、研究を横断し、ひとつの概念の来歴とつながりを探ります。", search: "すべての資料を検索", all: "すべて", browse: "メディア別に見る", refine: "絞り込む", topic: "すべてのトピック", sort: "並び順", clear: "条件をクリア", results: "検索結果", resultUnit: "件", previous: "前へ", next: "次へ", noImage: "画像なし", by: "著者 / 制作者", empty: "該当する資料はありません", emptyHint: "短いキーワードに変えるか、絞り込み条件を外してください。" },
  fr: { eyebrow: "FemRes · Index de recherche", title: "Rechercher", deck: "Suivez un concept à travers les livres, les images, les essais, les voix et la recherche féministe.", search: "Rechercher dans toute la collection", all: "Tous les médias", browse: "Parcourir par médium", refine: "Affiner", topic: "Tous les sujets", sort: "Trier par", clear: "Effacer les filtres", results: "Résultats", resultUnit: "éléments", previous: "Précédent", next: "Suivant", noImage: "Sans image", by: "Par", empty: "Aucun contenu correspondant", emptyHint: "Essayez un mot-clé plus court ou supprimez les filtres de médium et de sujet." },
};
const labels = copy[locale];

const collections: Record<ContentType, string> = {
  book: "books",
  article: "articles",
  film: "films",
  video: "videos",
  podcast: "podcasts",
  paper: "papers",
};
const contentLink = (type: ContentType, slug: string) =>
  getLocalizedPath(`${collections[type]}/${slug}`, locale);
const textOnlyContentTypes = new Set<ContentType>(["article", "paper"]);
const coverKind: Record<Exclude<ContentType, "article" | "paper">, "poster" | "cover" | "square" | "video"> = {
  book: "cover",
  film: "poster",
  video: "video",
  podcast: "square",
};
const cleanVisible = (value: string) => value.replace(/[\u2014\u2013]/g, " - ");
const typeLabel = (type: ContentType) => contentTypes.find((item) => item.value === type)?.label ?? type;
const formatDate = (date: Date) => new Intl.DateTimeFormat(locale, { year: "numeric", month: "short" }).format(date);

const pageNumbers = (() => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
  const pages: Array<number | "…"> = [1];
  if (validPage > 3) pages.push("…");
  for (let page = Math.max(2, validPage - 1); page <= Math.min(totalPages - 1, validPage + 1); page += 1) pages.push(page);
  if (validPage < totalPages - 2) pages.push("…");
  pages.push(totalPages);
  return pages;
})();
---

<main class="search-index">
  <header class="search-hero">
    <p class="search-hero__eyebrow">{labels.eyebrow}</p>
    <div class="search-hero__title">
      <h1>{labels.title}</h1>
      <p>{labels.deck}</p>
    </div>
    <form action={searchPath} method="get" class="search-form" role="search">
      {currentType && <input type="hidden" name="type" value={currentType} />}
      {currentTopic && <input type="hidden" name="topic" value={currentTopic} />}
      {currentSort !== "relevance" && <input type="hidden" name="sort" value={currentSort} />}
      <label for="search-input">{labels.search}</label>
      <div>
        <input id="search-input" type="search" name="q" value={currentQuery} placeholder={t("searchPage.placeholder")} autocomplete="off" />
        <button type="submit" aria-label={t("searchPage.title")}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
        </button>
      </div>
    </form>
    <dl class="search-hero__stats">
      <div><dt>{String(allContent.length).padStart(3, "0")}</dt><dd>{t("searchPage.subtitle", { count: allContent.length })}</dd></div>
      <div><dt>{String(allTopics.length).padStart(2, "0")}</dt><dd>{labels.topic}</dd></div>
    </dl>
  </header>

  <section class="search-media" aria-labelledby="search-media-title">
    <h2 id="search-media-title">{labels.browse}</h2>
    <nav aria-label={labels.browse}>
      <a class:list={{ active: currentType === "" }} href={getSearchUrl({ type: "", page: 1 })}>
        <span>00</span><strong>{labels.all}</strong><small>{allContent.length}</small>
      </a>
      {contentTypes.map((type, index) => (
        <a class:list={{ active: currentType === type.value }} href={getSearchUrl({ type: currentType === type.value ? "" : type.value, page: 1 })}>
          <span>{String(index + 1).padStart(2, "0")}</span><strong>{type.label}</strong><small>{type.count}</small>
        </a>
      ))}
    </nav>
  </section>

  <section class="search-results" aria-labelledby="search-results-title">
    <div class="search-results__tools">
      <div>
        <p>{labels.refine}</p>
        <label>
          <span class="sr-only">{labels.topic}</span>
          <select data-search-param="topic">
            <option value="" selected={currentTopic === ""}>{labels.topic}</option>
            {allTopics.map((topic) => <option value={topic} selected={currentTopic === topic}>{getTopicTranslation(topic, locale)}</option>)}
          </select>
        </label>
      </div>
      <label>
        <span>{labels.sort}</span>
        <select data-search-param="sort">
          <option value="relevance" selected={currentSort === "relevance"}>{t("searchPage.sort.relevance")}</option>
          <option value="date-desc" selected={currentSort === "date-desc"}>{t("searchPage.sort.newest")}</option>
          <option value="date-asc" selected={currentSort === "date-asc"}>{t("searchPage.sort.oldest")}</option>
          <option value="title-asc" selected={currentSort === "title-asc"}>{t("searchPage.sort.az")}</option>
          <option value="title-desc" selected={currentSort === "title-desc"}>{t("searchPage.sort.za")}</option>
        </select>
      </label>
      {(currentQuery || currentType || currentTopic || currentSort !== "relevance") && <a class="search-clear" href={searchPath}>{labels.clear}</a>}
    </div>

    <div class="search-results__heading">
      <h2 id="search-results-title">{labels.results}</h2>
      <p><strong>{String(totalResults).padStart(2, "0")}</strong> {labels.resultUnit}</p>
    </div>

    {currentItems.length > 0 ? (
      <div class="search-result-list">
        {currentItems.map((item, index) => (
          <a
            href={contentLink(item.contentType, item.cleanSlug)}
            class={`search-entry search-entry--${item.contentType} ${textOnlyContentTypes.has(item.contentType) ? "search-entry--text" : ""}`}
          >
            <div class="search-entry__number">{String((validPage - 1) * 24 + index + 1).padStart(2, "0")}</div>
            {!textOnlyContentTypes.has(item.contentType) && (
              <CoverImage
                class="search-entry__cover"
                src={item.image}
                alt=""
                kind={coverKind[item.contentType as Exclude<ContentType, "article" | "paper">]}
                loading={index === 0 ? "eager" : "lazy"}
              >
                <span slot="placeholder">{labels.noImage}</span>
              </CoverImage>
            )}
            <div class="search-entry__copy">
              <p class="search-entry__meta"><span>{typeLabel(item.contentType)}</span> · {formatDate(item.date)}</p>
              <h3>{cleanVisible(item.title)}</h3>
              {item.originalTitle && item.originalTitle !== item.title && <em>{cleanVisible(item.originalTitle)}</em>}
              <p class="search-entry__author"><b>{labels.by}</b> {cleanVisible(item.author)}</p>
              <p class="search-entry__description">{cleanVisible(item.description)}</p>
              <ul>{item.topics.slice(0, 3).map((topic) => <li>{getTopicTranslation(topic, locale)}</li>)}</ul>
            </div>
            <span class="search-entry__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="search-empty">
        <h3>{labels.empty}</h3>
        <p>{labels.emptyHint}</p>
        <a href={searchPath}>{labels.clear}</a>
      </div>
    )}

    {totalPages > 1 && (
      <nav class="search-pagination" aria-label={t("common.pagination.navigation")}>
        {validPage > 1 ? <a href={getSearchUrl({ page: validPage - 1 })}>{labels.previous}</a> : <span>{labels.previous}</span>}
        <div>
          {pageNumbers.map((page) => page === "…" ? <span>…</span> : page === validPage ? <strong aria-current="page">{page}</strong> : <a href={getSearchUrl({ page })}>{page}</a>)}
        </div>
        {validPage < totalPages ? <a href={getSearchUrl({ page: validPage + 1 })}>{labels.next}</a> : <span>{labels.next}</span>}
      </nav>
    )}
  </section>
</main>

<script>
  function initEditorialSearch() {
    document.querySelectorAll("[data-search-param]").forEach((element) => {
      if (!(element instanceof HTMLSelectElement) || element.dataset.ready === "true") return;
      element.dataset.ready = "true";
      element.addEventListener("change", () => {
        const params = new URLSearchParams(window.location.search);
        const name = element.dataset.searchParam ?? "";
        params.delete("page");
        if (!element.value || (name === "sort" && element.value === "relevance")) params.delete(name);
        else params.set(name, element.value);
        const query = params.toString();
        window.location.href = query ? `${window.location.pathname}?${query}` : window.location.pathname;
      });
    });
  }
  document.addEventListener("astro:page-load", initEditorialSearch);
</script>

<style>
  .search-index { --accent:#cf2721; min-height:100dvh; padding-bottom:84px; color:var(--ink); background:var(--paper); font-family:var(--editorial-sans); }

  .search-hero,.search-media,.search-results { width:min(100% - var(--editorial-canvas-gutter),var(--editorial-canvas-width)); margin-inline:auto; }
  .search-hero { display:grid; grid-template-columns:1fr .86fr; gap:44px 90px; padding:54px 0 64px; }
  .search-hero__eyebrow { grid-column:1 / -1; margin:0; color:var(--accent); font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .search-hero__title h1 { margin:0; font-family:var(--editorial-serif); font-size:clamp(88px,13vw,180px); font-weight:600; letter-spacing:-.075em; line-height:.8; }
  .search-hero__title p { max-width:560px; margin:36px 0 0; font-family:var(--editorial-serif); font-size:clamp(19px,2.1vw,29px); line-height:1.55; }
  .search-form { align-self:end; padding-bottom:4px; }
  .search-form > label { display:block; margin-bottom:14px; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .search-form > div { display:grid; grid-template-columns:1fr 54px; border-bottom:2px solid var(--ink); }
  .search-form input { min-width:0; padding:13px 0 16px; color:var(--ink); background:transparent; border:0; border-radius:0; outline:0; font:500 clamp(20px,2.2vw,31px)/1.3 var(--editorial-serif); }
  .search-form input::placeholder { color:var(--muted); opacity:.72; }
  .search-form button { display:grid; place-items:center; padding:0; color:var(--ink); background:transparent; border:0; cursor:pointer; }
  .search-form button:hover { color:var(--accent); }
  .search-form svg { width:28px; fill:none; stroke:currentColor; stroke-width:1.6; }
  .search-hero__stats { grid-column:1 / -1; display:grid; grid-template-columns:repeat(2,minmax(0,260px)); margin:10px 0 0; border-top:1px solid var(--line); }
  .search-hero__stats div { padding:17px 26px 0 0; border-right:1px solid var(--line); }
  .search-hero__stats dt { color:var(--accent); font-family:var(--editorial-serif); font-size:34px; line-height:1; }
  .search-hero__stats dd { margin:8px 0 0; color:var(--muted); font-size:10px; }
  .search-media { display:grid; grid-template-columns:190px 1fr; gap:42px; padding:37px 0 44px; border-block:2px solid var(--ink); }
  .search-media h2 { margin:0; font-family:var(--editorial-serif); font-size:33px; font-weight:600; line-height:1.1; }
  .search-media nav { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .search-media a { display:grid; grid-template-columns:auto 1fr auto; gap:10px; align-items:baseline; min-height:76px; padding:15px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .search-media a:hover,.search-media a.active { color:var(--paper); background:var(--ink); }
  .search-media a span,.search-media a small { color:var(--muted); font-size:9px; }
  .search-media a.active span,.search-media a.active small,.search-media a:hover span,.search-media a:hover small { color:color-mix(in srgb,var(--paper) 65%,transparent); }
  .search-media a strong { font-family:var(--editorial-serif); font-size:18px; font-weight:600; }
  .search-results { padding:58px 0 0; }
  .search-results__tools { display:grid; grid-template-columns:1fr auto auto; align-items:end; gap:28px; padding-bottom:28px; border-bottom:1px solid var(--line); }
  .search-results__tools > div { display:flex; align-items:end; gap:20px; }
  .search-results__tools p,.search-results__tools label > span { margin:0 0 10px; color:var(--muted); font-size:9px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .search-results__tools label { display:grid; }
  .search-results__tools select { min-width:190px; padding:8px 26px 9px 2px; color:var(--ink); background:transparent; border:0; border-bottom:1px solid var(--ink); border-radius:0; font:600 12px/1.3 var(--editorial-sans); cursor:pointer; }
  .search-clear { padding-bottom:9px; color:var(--accent); border-bottom:1px solid currentColor; font-size:11px; font-weight:700; }
  .search-results__heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; padding:52px 0 28px; }
  .search-results__heading h2 { margin:0; font-family:var(--editorial-serif); font-size:clamp(50px,7vw,90px); font-weight:600; letter-spacing:-.055em; line-height:1; }
  .search-results__heading p { margin:0; color:var(--muted); font-size:11px; }
  .search-results__heading strong { color:var(--accent); font:500 27px/1 Georgia,serif; }
  .search-result-list { border-top:1px solid var(--ink); }
  .search-entry { display:grid; grid-template-columns:42px 150px minmax(0,1fr) 30px; gap:24px; min-height:205px; padding:22px 0; border-bottom:1px solid var(--line); }
  .search-entry--text { grid-template-columns:42px minmax(0,1fr) 30px; min-height:174px; padding-block:28px; }
  .search-entry:hover h3,.search-entry:hover .search-entry__arrow { color:var(--accent); }
  .search-entry__number { padding-top:3px; color:var(--muted); font-size:9px; }
  .search-entry__image { display:grid; place-items:center; width:150px; align-self:start; overflow:hidden; background:var(--paper-deep); }
  .search-entry :global(.search-entry__cover) { align-self:start; }
  .search-entry__image img { display:block; width:100%; height:auto; object-fit:contain; transition:transform .35s ease; }
  .search-entry:hover .search-entry__image img { transform:scale(1.025); }
  .search-entry__image span { display:grid; width:100%; aspect-ratio:1; place-items:center; color:var(--muted); font-size:9px; }
  .search-entry__copy { align-self:center; max-width:820px; }
  .search-entry__meta { margin:0 0 8px; color:var(--muted); font-size:10px; }
  .search-entry__meta span { color:var(--accent); font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
  .search-entry h3 { margin:0; font-family:var(--editorial-serif); font-size:clamp(25px,3vw,42px); font-weight:600; letter-spacing:-.035em; line-height:1.12; transition:color .2s ease; }
  .search-entry em { display:block; margin-top:7px; color:var(--muted); font:italic 14px/1.4 Georgia,serif; }
  .search-entry__author { margin:12px 0 0; color:var(--muted); font-size:11px; }
  .search-entry__author b { color:var(--ink); font-size:9px; letter-spacing:.06em; text-transform:uppercase; }
  .search-entry__description { display:-webkit-box; max-width:70ch; margin:12px 0 0; overflow:hidden; color:var(--muted); font-family:var(--editorial-serif); font-size:14px; line-height:1.65; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .search-entry ul { display:flex; flex-wrap:wrap; gap:7px 14px; margin:12px 0 0; padding:0; list-style:none; color:var(--muted); font-size:9px; }
  .search-entry li::before { content:"·"; margin-right:5px; color:var(--accent); }
  .search-entry__arrow { align-self:center; font:300 25px/1 Georgia,serif; transition:color .2s ease; }
  .search-empty { padding:90px 0; border-block:1px solid var(--line); text-align:center; }
  .search-empty h3 { margin:0 0 14px; font-family:var(--editorial-serif); font-size:36px; }
  .search-empty p { margin:0 0 24px; color:var(--muted); }
  .search-empty a { color:var(--accent); border-bottom:1px solid currentColor; font-size:12px; }
  .search-pagination { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:30px; margin-top:54px; padding-top:20px; border-top:1px solid var(--ink); font-size:12px; }
  .search-pagination > :last-child { justify-self:end; }
  .search-pagination > span { color:var(--muted); }
  .search-pagination > div { display:flex; align-items:center; gap:8px; }
  .search-pagination > div a,.search-pagination strong { display:grid; place-items:center; width:32px; height:32px; }
  .search-pagination strong { color:var(--paper); background:var(--ink); font-weight:600; }
  @media(max-width:900px){ .search-hero{grid-template-columns:1fr}.search-form{max-width:680px}.search-media{grid-template-columns:1fr}.search-media nav{grid-template-columns:repeat(3,1fr)} }
  @media(max-width:700px){ .search-hero,.search-media,.search-results{width:calc(100% - 24px)}.search-index{padding-bottom:62px}.search-hero{gap:30px;padding:42px 0}.search-hero__title h1{font-size:84px}.search-hero__title p{margin-top:24px;font-size:19px}.search-form input{font-size:20px}.search-hero__stats{grid-template-columns:repeat(2,1fr)}.search-hero__stats div{padding-right:10px}.search-hero__stats dd{font-size:8px}.search-media{gap:24px;padding:30px 0 34px}.search-media h2{font-size:32px}.search-media nav{grid-template-columns:repeat(2,1fr)}.search-media a{min-height:65px;padding:12px 10px}.search-media a strong{font-size:15px}.search-results{padding-top:40px}.search-results__tools{grid-template-columns:1fr;gap:20px}.search-results__tools>div{display:grid;gap:10px}.search-results__tools select{width:100%}.search-clear{justify-self:start}.search-results__heading{display:block;padding-top:40px}.search-results__heading h2{font-size:46px;white-space:nowrap}.search-results__heading p{margin-top:9px}.search-entry{grid-template-columns:18px 72px minmax(0,1fr);gap:10px;min-height:132px;padding:16px 0}.search-entry--text{grid-template-columns:18px minmax(0,1fr);min-height:112px;padding-block:18px}.search-entry__copy{min-width:0;width:100%}.search-entry--podcast .search-entry__copy{align-self:start}.search-entry__image{width:72px}.search-entry h3{max-width:none;font-size:20px;line-height:1.2;writing-mode:horizontal-tb}.search-entry__meta{font-size:8px}.search-entry__author{font-size:9px}.search-entry__description,.search-entry ul,.search-entry em,.search-entry__arrow{display:none}.search-pagination{grid-template-columns:1fr 1fr}.search-pagination>div{grid-column:1 / -1;grid-row:1;justify-content:center}.search-pagination>:last-child{justify-self:end} }
  @media(prefers-reduced-motion:reduce){.search-entry__image img{transition:none}}
</style>
