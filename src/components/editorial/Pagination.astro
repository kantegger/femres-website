---
interface Props {
  totalPages: number;
  validPage: number;
  getUrl: (page: number) => string;
  previousLabel: string;
  nextLabel: string;
  navLabel: string;
}

const { totalPages, validPage, getUrl, previousLabel, nextLabel, navLabel } = Astro.props;

const pageNumbers = (() => {
  if (totalPages <= 7) return Array.from({ length: totalPages }, (_, index) => index + 1);
  const pages: Array<number | "…"> = [1];
  if (validPage > 3) pages.push("…");
  for (let page = Math.max(2, validPage - 1); page <= Math.min(totalPages - 1, validPage + 1); page += 1) pages.push(page);
  if (validPage < totalPages - 2) pages.push("…");
  pages.push(totalPages);
  return pages;
})();
---

{totalPages > 1 && (
  <nav class="ed-pagination" aria-label={navLabel}>
    {validPage > 1 ? <a href={getUrl(validPage - 1)}>{previousLabel}</a> : <span>{previousLabel}</span>}
    <div>
      {pageNumbers.map((page) => page === "…" ? (
        <span class="ed-pagination__ellipsis">…</span>
      ) : page === validPage ? (
        <strong aria-current="page">{page}</strong>
      ) : (
        <a href={getUrl(page)}>{page}</a>
      ))}
    </div>
    {validPage < totalPages ? <a href={getUrl(validPage + 1)}>{nextLabel}</a> : <span>{nextLabel}</span>}
  </nav>
)}

<style>
  .ed-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; margin-top: 60px; padding-top: 20px; border-top: 1px solid var(--ink); font-size: 12px; }
  .ed-pagination > :last-child { justify-self: end; }
  .ed-pagination > span { color: var(--muted); }
  .ed-pagination > div { display: flex; align-items: center; gap: 8px; }
  .ed-pagination > div a, .ed-pagination strong { display: grid; place-items: center; width: 32px; height: 32px; }
  .ed-pagination strong { color: var(--paper); background: var(--ink); font-weight: 600; }
  .ed-pagination__ellipsis { padding: 0 4px; color: var(--muted); }

  @media (max-width: 700px) {
    .ed-pagination { grid-template-columns: 1fr 1fr; }
    .ed-pagination > div { grid-column: 1 / -1; grid-row: 1; justify-content: center; }
    .ed-pagination > :last-child { justify-self: end; }
  }
</style>
