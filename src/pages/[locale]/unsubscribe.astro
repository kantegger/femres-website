---
export const prerender = true;
import NewsletterPreferences from "../../components/NewsletterPreferences.astro";
import type { Locale } from "../../i18n";
import { nonDefaultDetailLocales } from "../../lib/localeDetails";

export function getStaticPaths() {
  return nonDefaultDetailLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---
<NewsletterPreferences locale={locale} />
