---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import EditorialFilmDetail from "../../../components/EditorialFilmDetail.astro";
import SchemaMarkup from "../../../components/seo/SchemaMarkup.astro";
import { getLocalizedCollectionDetailPaths } from "../../../lib/content";
import {
  nonDefaultDetailLocales,
  type SupportedDetailLocale,
} from "../../../lib/localeDetails";

export async function getStaticPaths() {
  return getLocalizedCollectionDetailPaths(
    "films",
    nonDefaultDetailLocales,
    "film",
    "allFilms",
  );
}

const { film, locale, allFilms } = Astro.props;
const currentLocale = locale as SupportedDetailLocale;
---

<Layout
  title={`${film.data.title} - ${film.data.director} - FemRes`}
  description={film.data.description}
  image={film.data.posterImage}
  headerVariant="editorial"
  showMusicPlayer={false}
>
  <SchemaMarkup
    slot="head"
    type="Movie"
    data={{ ...film.data, coverImage: film.data.posterImage }}
  />
  <EditorialFilmDetail film={film} allFilms={allFilms} locale={currentLocale} />
</Layout>
