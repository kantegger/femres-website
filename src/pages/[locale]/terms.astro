---
import EditorialLegalDocument from "../../components/EditorialLegalDocument.astro";
import type { Locale } from "../../i18n/index";
import { getEntry, render } from "astro:content";

const { locale } = Astro.params;
const currentLocale = (locale || "en") as Locale;

// Map locale to file suffix (zh-CN uses no suffix, zh-TW uses -tw)
const getFileSuffix = (locale: string) => {
  if (locale === "zh-CN") return "";
  if (locale === "zh-TW") return "-tw";
  return `-${locale}`;
};

const entrySlug =
  currentLocale === "zh-CN" ? "terms" : `terms${getFileSuffix(currentLocale)}`;
const entry =
  (await getEntry("pages", entrySlug)) || (await getEntry("pages", "terms-en"));
if (!entry) {
  return Astro.redirect("/404");
}
const { Content } = await render(entry);
---

<EditorialLegalDocument
  locale={currentLocale}
  kind="terms"
  title={entry.data.title}
  intro={entry.data.intro}
  lastUpdated={entry.data.lastUpdated}
>
  <Content />
</EditorialLegalDocument>
