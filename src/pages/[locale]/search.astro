---
import Layout from "../../layouts/Layout.astro";
import EditorialSearch from "../../components/EditorialSearch.astro";
import { createT, type Locale } from "../../i18n";

export const prerender = false;

const currentLocale = Astro.params.locale as Locale;
const t = createT(currentLocale);
---

<Layout
  title={`${t("searchPage.title")} - FemRes`}
  description={t("searchPage.metaDescription")}
  headerVariant="editorial"
  showMusicPlayer={false}
>
  <EditorialSearch locale={currentLocale} pathMode="locale" />
</Layout>
