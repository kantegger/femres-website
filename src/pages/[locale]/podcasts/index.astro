---
export const prerender = false;

import EditorialPodcastIndex from "../../../components/EditorialPodcastIndex.astro";
import { createT } from "../../../i18n";
import Layout from "../../../layouts/Layout.astro";
import {
  isSupportedDetailLocale,
  type SupportedDetailLocale,
} from "../../../lib/localeDetails";

const { locale } = Astro.params;
if (!isSupportedDetailLocale(locale)) return Astro.redirect("/404");
const currentLocale = locale;
const t = createT(currentLocale);
const pageTitles: Record<SupportedDetailLocale, string> = {
  "zh-CN": "播客",
  en: "Podcasts",
  "zh-TW": "播客",
  ja: "ポッドキャスト",
  fr: "Podcasts",
};
---

<Layout
  title={`${pageTitles[currentLocale]} - FemRes`}
  description={t("podcastsPage.subtitle")}
  headerVariant="editorial"
  showMusicPlayer={false}
>
  <EditorialPodcastIndex locale={currentLocale} pathMode="locale" />
</Layout>
