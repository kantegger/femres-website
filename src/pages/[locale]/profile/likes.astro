---
export const prerender = true;

import ProfileContentListPage from "../../../components/ProfileContentListPage.astro";
import { createT, getLocalizedPath } from "../../../i18n";
import { type Locale } from "../../../i18n/types";
import { getUserContentListStrings } from "../../../lib/profileTranslations";
import { nonDefaultDetailLocales } from "../../../lib/localeDetails";

export function getStaticPaths() {
  return nonDefaultDetailLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const currentLocale = locale as Locale;
const t = createT(currentLocale);
const contentListStrings = getUserContentListStrings(currentLocale);
---

<ProfileContentListPage
  type="likes"
  locale={currentLocale}
  title={t("profilePage.likes.title")}
  description={t("profilePage.likes.description")}
  emptyMessage={t("profilePage.likes.emptyMessage")}
  homeLabel={t("profilePage.breadcrumb.home")}
  profileLabel={t("profilePage.breadcrumb.profile")}
  homeLink={getLocalizedPath("/", currentLocale)}
  profileLink={getLocalizedPath("profile", currentLocale)}
  icon="❤️"
  iconClassName="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-pink-100 to-red-100 dark:from-pink-900 dark:to-red-900 rounded-full mb-4"
  uiStrings={contentListStrings}
/>
