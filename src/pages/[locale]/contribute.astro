---
export const prerender = true;
import EditorialContribute from "../../components/EditorialContribute.astro";
import Layout from "../../layouts/Layout.astro";
import { createT, type Locale } from "../../i18n";

export function getStaticPaths() { return ["en", "zh-TW", "ja", "fr"].map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const t = createT(locale);
---

<Layout title={`${t("contribute.title")} - FemRes`} description={t("contribute.subtitle")} headerVariant="editorial" showMusicPlayer={false}>
  <EditorialContribute locale={locale} />
</Layout>
