---
export const prerender = true;

import Layout from "../../../layouts/Layout.astro";
import EditorialArticleDetail from "../../../components/EditorialArticleDetail.astro";
import SchemaMarkup from "../../../components/seo/SchemaMarkup.astro";
import { getLocalizedCollectionDetailPaths } from "../../../lib/content";
import { getEditorialShareImage } from "../../../lib/editorialShareImage";
import { nonDefaultDetailLocales, type SupportedDetailLocale } from "../../../lib/localeDetails";

export async function getStaticPaths() {
  return getLocalizedCollectionDetailPaths("articles", nonDefaultDetailLocales, "article", "allArticles");
}

const { article, locale, allArticles } = Astro.props;
const currentLocale = locale as SupportedDetailLocale;
const shareImage = getEditorialShareImage("article");
---

<Layout
  title={`${article.data.title} - FemRes`}
  description={article.data.description}
  image={shareImage}
  headerVariant="editorial"
  showMusicPlayer={false}
>
  <SchemaMarkup slot="head" type="Article" data={{ ...article.data, coverImage: shareImage }} />
  <EditorialArticleDetail article={article} allArticles={allArticles} locale={currentLocale} />
</Layout>
