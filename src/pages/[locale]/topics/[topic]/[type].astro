---
export const prerender=true;
import Layout from "../../../../layouts/Layout.astro";
import EditorialTopicType from "../../../../components/EditorialTopicType.astro";
import { createT,type Locale } from "../../../../i18n";
import { buildTopicTypeView,getLocalizedTopicTypeStaticPaths,type TopicTypeEntry } from "../../../../lib/topicPages";
import { nonDefaultDetailLocales } from "../../../../lib/localeDetails";
export function getStaticPaths(){return getLocalizedTopicTypeStaticPaths(nonDefaultDetailLocales);}
const currentLocale=Astro.params.locale as Locale;
const {topic,typeObj}=Astro.props as {topic:string;typeObj:TopicTypeEntry};
const t=createT(currentLocale);
const {translatedTopic,typeLabels}=await buildTopicTypeView(topic,typeObj,currentLocale,t);
---
<Layout title={`${translatedTopic} - ${typeLabels[typeObj.contentType]} - FemRes`} description={t("topicDetailPage.description").replace("{topic}",translatedTopic)} headerVariant="editorial" showMusicPlayer={false}>
  <EditorialTopicType topic={topic} typeObj={typeObj} locale={currentLocale}/>
</Layout>
