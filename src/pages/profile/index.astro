---
import ProfilePage from "../../components/ProfilePage.astro";
import { createT, type Locale } from "../../i18n";
import { getProfileUiStrings } from "../../lib/profileTranslations";

const currentLocale: Locale = "zh-CN";
const t = createT(currentLocale);
const uiStrings = getProfileUiStrings(currentLocale);
---

<ProfilePage
  locale={currentLocale}
  title={t("profilePage.title")}
  description={t("profilePage.description")}
  uiStrings={uiStrings}
/>
