---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import EditorialBookDetail from "../../components/EditorialBookDetail.astro";
import SchemaMarkup from "../../components/seo/SchemaMarkup.astro";
import { getCollectionDetailPathsForLocale } from "../../lib/content";

export async function getStaticPaths() {
  return getCollectionDetailPathsForLocale("books", "zh-CN", "book", "allBooks");
}

const { book, allBooks } = Astro.props;
---

<Layout
  title={`${book.data.title} - ${book.data.author} - FemRes`}
  description={book.data.description}
  image={book.data.coverImage}
  headerVariant="editorial"
  showMusicPlayer={false}
>
  <SchemaMarkup slot="head" type="Book" data={book.data} />
  <EditorialBookDetail book={book} allBooks={allBooks} locale="zh-CN" />
</Layout>
