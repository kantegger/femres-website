{
  "name": "femres",
  "type": "module",
  "version": "0.0.1",
  "description": "FemRes - 女性主义内容聚合平台",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "astro check",
    "test:e2e": "playwright test",
    "test:frontend-performance": "node --test test/frontend-performance.test.mjs",
    "test:i18n": "node --test test/i18n-integrity.test.mjs && tsx --test test/i18n-utils.test.ts",
    "test:seo": "node --test test/seo.test.mjs",
    "test:seo:generated": "node scripts/check-generated-seo.mjs",
    "test:film-metadata": "node --test test/film-metadata.test.mjs",
    "test:issue-selection": "tsx --test test/issue-selection.test.ts test/issues.test.ts",
    "test:architecture": "node scripts/check-component-reachability.mjs",
    "test:links": "node scripts/check-built-links.mjs",
    "test:performance-budget": "node scripts/check-performance-budget.mjs",
    "test:dependency-security": "npm audit --omit=dev --audit-level=high",
    "test:public-snapshot": "node --test test/public-snapshot-security.test.mjs",
    "audit:public-snapshot": "node scripts/public-snapshot-policy.mjs .",
    "export:public-snapshot": "node scripts/export-public-snapshot.mjs",
    "test:db-security": "node --test test/database-security.test.mjs",
    "content:audit": "tsx scripts/audit-content.ts",
    "migrate": "tsx scripts/migrate-to-supabase.ts",
    "upload:r2": "tsx scripts/upload-to-r2.ts",
    "upload:r2:single": "tsx scripts/upload-single-to-r2.ts",
    "sync:book-covers": "tsx scripts/sync-book-covers.ts",
    "sync:film-posters": "tsx scripts/sync-film-posters.ts",
    "update:cdn": "tsx scripts/update-cdn-urls.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "11.0.3",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "astro": "7.1.1",
    "mime": "^4.1.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
